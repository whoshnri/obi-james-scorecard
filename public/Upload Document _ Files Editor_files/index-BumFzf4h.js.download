let intervalId;

self.onmessage = function(e) {
  const { interval, command } = e.data;

  if (command === 'start') {
    if (intervalId) clearInterval(intervalId);
    intervalId = setInterval(() => {
      postMessage('poll');
    }, interval);
  }

  if (command === 'stop') {
    clearInterval(intervalId);
    intervalId = null;
